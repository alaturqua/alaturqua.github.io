  "narrative": {
    "northStar": "The Braun Spec Sheet",
    "overview": "Warm grey paper, graphite ink, 1px hairline rules on a 12-column grid. Information is set like a product data sheet: label column in mute, value in ink, a rule under every row. Illustration is always a hairline line drawing; colour arrives as a stage hue on the moving datum, the dot that keys a row, or the panel it belongs to.\n\nUser-steered divergences from the original single-orange contract: the palette widened to five stage hues (blue, violet, amber, green, rose), each bound to one part of a data platform, and the signature diagram is coloured by stage rather than drawn in ink alone. Orange survived as the indicator: wordmark dot, status dot, the period after the name, the \"now\" career marker, and the primary call to action. The page ends in a deep-blue close band, the only full-bleed colour surface.",
    "keyCharacteristics": [
      "Hairline 1px rules as the main structural device; flat surfaces.",
      "One sans family (Hanken Grotesk 300–700), tight negative tracking at display sizes.",
      "Stage hues mapped `k0..k4` and applied through one `--k` custom property.",
      "Light, dark and system themes via a three-way segmented control; every token has a dark twin.",
      "Motion is data-shaped: strokes draw, packets travel, names lift; all off under reduced motion."
    ],
    "rules": [
      {
        "name": "The Indicator Rule",
        "body": "Orange marks only identity, live status and the primary action; it is never a stage hue or a surface.",
        "section": "colors"
      },
      {
        "name": "The One Variable Rule",
        "body": "Stage colour is set once per element via `k0..k4` and consumed as `var(--k)`; no component hard-codes a stage hex.",
        "section": "colors"
      },
      {
        "name": "The Tint Ceiling Rule",
        "body": "Stage hues tint by `color-mix` with paper: 8% art wells, 11% panels, 14–18% chips and hub nodes; text in a stage hue is mixed 65–70% with ink.",
        "section": "colors"
      },
      {
        "name": "The Dark Twin Rule",
        "body": "Each token is redefined for dark in both the media query and `:root[data-theme=\"dark\"]`; add a token in all three places or not at all.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Years, counts and dates use `.num` (tabular-nums).",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Nothing casts a shadow at rest except the play chip over a photograph.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** draw every illustration as 1px hairline, colouring only the moving or \"hot\" datum and the stage it belongs to.",
      "**Do** bind colour through `k0..k4` and `--k`, and keep the stage-to-hue mapping fixed.",
      "**Do** separate list rows with a 1px rule rather than cards.",
      "**Do** give every animation a reduced-motion end state that shows the finished drawing.",
      "**Do** render photographs grayscale at rest, restoring colour on hover."
    ],
    "donts": [
      "**Don't** use orange as a stage hue, a large fill, or decoration beyond the indicator set.",
      "**Don't** add a second typeface or a display face.",
      "**Don't** use dark-neon developer styling or glow effects.",
      "**Don't** add resting shadows to panels or rows."
    ]
  }
}